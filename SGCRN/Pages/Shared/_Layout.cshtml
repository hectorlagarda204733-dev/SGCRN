<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · SGCRN</title>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="container d-flex align-items-center justify-content-between gap-3" aria-label="Navegación principal">
            <a class="brand" asp-page="/ProductosTerminados/Index">SGCRN <span>Remedios naturales</span></a>
            <a class="nav-link" asp-page="/ProductosTerminados/Index">Catálogo de productos</a>
        </nav>
    </header>
    <main class="container py-4 py-lg-5">
        <div class="eyebrow mb-2">AVANCE 01 · CASO DE USO 01</div>
        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="alert alert-success" role="status">@mensaje</div>
        }
        @RenderBody()
    </main>
    <footer class="container py-4 text-muted small border-top">
        Sistema de Gestión y Catálogo de Remedios Naturales · Registrar / Consultar Producto del Catálogo
    </footer>
</body>
</html>
