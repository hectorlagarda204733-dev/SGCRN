@page "{id:long}"
@model SGCRN.Pages.ProductosTerminados.EditModel
@{
    ViewData["Title"] = "Editar producto";
}

<h1>Editar producto</h1>
<p class="text-muted">Actualiza la información del catálogo. Las existencias se conservan.</p>
<div class="panel form-panel">
    <form method="post" novalidate>
        <partial name="_Campos" for="Input" />
        <div class="d-flex justify-content-end gap-2">
            <a class="btn btn-outline-secondary" asp-page="Index">Cancelar</a>
            <button class="btn btn-success" type="submit">Guardar cambios</button>
        </div>
    </form>
</div>
