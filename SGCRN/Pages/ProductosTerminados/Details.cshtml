@page "{id:long}"
@model SGCRN.Pages.ProductosTerminados.DetailsModel
@{
    ViewData["Title"] = "Consultar producto";
}

<h1>Consultar producto</h1>
<p class="text-muted">Información registrada en el catálogo.</p>
<article class="panel form-panel">
    <div class="d-flex justify-content-between gap-3 mb-3">
        <h2 class="h4">@Model.Producto.Nombre</h2>
        <span class="badge align-self-start @(Model.Producto.Activo ? "text-bg-success" : "text-bg-secondary")">@(Model.Producto.Activo ? "Activo" : "Inactivo")</span>
    </div>
    <p>@(Model.Producto.Descripcion ?? "Sin descripción.")</p>
    <dl class="row">
        <dt class="col-sm-5">Identificador</dt><dd class="col-sm-7">@Model.Producto.Id</dd>
        <dt class="col-sm-5">Unidad de medida</dt><dd class="col-sm-7">@Model.Producto.UnidadMedida</dd>
        <dt class="col-sm-5">Precio sugerido</dt><dd class="col-sm-7">@Model.Producto.PrecioSugerido.ToString("C2")</dd>
        <dt class="col-sm-5">Existencias actuales</dt><dd class="col-sm-7">@Model.Producto.StockActual.ToString("N3")</dd>
        <dt class="col-sm-5">Existencias mínimas</dt><dd class="col-sm-7">@Model.Producto.StockMinimo.ToString("N3")</dd>
        <dt class="col-sm-5">Fecha de registro</dt><dd class="col-sm-7">@Model.Producto.CreadoEn.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt class="col-sm-5">Última actualización</dt><dd class="col-sm-7">@Model.Producto.ActualizadoEn.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt class="col-sm-5">URL de imagen</dt><dd class="col-sm-7 text-break">@(string.IsNullOrWhiteSpace(Model.Producto.ImagenUrl) ? "Sin imagen." : Model.Producto.ImagenUrl)</dd>
    </dl>
    <div class="d-flex justify-content-end gap-2">
        <a class="btn btn-outline-secondary" asp-page="Index">Volver al catálogo</a>
        <a class="btn btn-success" asp-page="Edit" asp-route-id="@Model.Producto.Id">Editar producto</a>
    </div>
</article>
