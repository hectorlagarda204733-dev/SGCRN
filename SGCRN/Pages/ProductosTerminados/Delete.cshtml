@page "{id:long}"
@model SGCRN.Pages.ProductosTerminados.DeleteModel
@{
    ViewData["Title"] = "Baja lógica de producto";
}

<h1>Baja lógica de producto</h1>
<p class="text-muted">Confirma la operación antes de continuar.</p>
<div class="panel form-panel">
    <form method="post">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <p>¿Deseas dar de baja el producto <strong>@Model.Producto.Nombre</strong>?</p>
        <div class="alert alert-warning">El estado cambiará a <strong>Inactivo</strong>. Su información permanecerá guardada.</div>
        <div class="d-flex justify-content-end gap-2">
            <a class="btn btn-outline-secondary" asp-page="Index">Cancelar</a>
            @if (Model.Producto.Activo)
            {
                <button class="btn btn-danger" type="submit">Confirmar baja</button>
            }
        </div>
    </form>
</div>
