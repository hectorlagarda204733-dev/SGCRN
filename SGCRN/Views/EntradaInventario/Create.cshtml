@model EntradaInventarioInput
@{
    ViewData["Title"] = "Registrar entrada";
    var materias = (IReadOnlyList<MateriaPrima>)ViewData["MateriasPrimas"]!;
    var productos = (IReadOnlyList<ProductoTerminado>)ViewData["Productos"]!;
}
<nav class="breadcrumb-trail" aria-label="Ubicación"><a asp-action="Index">Entradas</a><span aria-hidden="true">/</span><span>Registrar entrada</span></nav>
<header class="page-heading"><div><h1>Registrar entrada</h1><p class="page-description">Registra lo recibido para actualizar tus existencias.</p></div></header>
<partial name="_FormFeedback" />
<div class="form-layout">
    <form class="form-sheet" asp-action="Create" method="post" novalidate data-save-form data-entry-form>
        <section class="form-section" aria-labelledby="entrada-origen">
            <div class="section-heading"><h2 id="entrada-origen">01 · Origen y artículo</h2></div>
            <fieldset class="field">
                <legend class="field-label">¿De dónde viene esta entrada?</legend>
                <div class="choice-group">
                    <label class="choice"><input asp-for="TipoOrigen" type="radio" value="Compra" id="origen-compra" required aria-describedby="TipoOrigen-error" /><span><strong>Compra</strong><small>Recibí una materia prima.</small></span></label>
                    <label class="choice"><input asp-for="TipoOrigen" type="radio" value="Produccion" id="origen-produccion" required aria-describedby="TipoOrigen-error" /><span><strong>Producción</strong><small>Terminé un producto.</small></span></label>
                </div><span asp-validation-for="TipoOrigen" id="TipoOrigen-error"></span>
            </fieldset>
            <div class="field" data-destination="Compra">
                <label asp-for="MateriaPrimaId" class="field-label">Materia prima recibida</label>
                <select asp-for="MateriaPrimaId" class="field-control" aria-describedby="MateriaPrimaId-error">
                    <option value="">Selecciona una materia prima</option>
                    @foreach (var materia in materias) { <option value="@materia.Id" data-name="@materia.Nombre" data-unit="@materia.UnidadMedida">@materia.Nombre (@materia.UnidadMedida)</option> }
                </select><span asp-validation-for="MateriaPrimaId" id="MateriaPrimaId-error"></span>
                @if (materias.Count == 0) { <span class="field-help">No hay materias primas activas. <a asp-controller="MateriaPrima" asp-action="Create">Crear una materia prima</a>.</span> }
            </div>
            <div class="field" data-destination="Produccion">
                <label asp-for="ProductoTerminadoId" class="field-label">Producto terminado</label>
                <select asp-for="ProductoTerminadoId" class="field-control" aria-describedby="ProductoTerminadoId-error">
                    <option value="">Selecciona un producto</option>
                    @foreach (var producto in productos) { <option value="@producto.Id" data-name="@producto.Nombre" data-unit="@producto.UnidadMedida">@producto.Nombre (@producto.UnidadMedida)</option> }
                </select><span asp-validation-for="ProductoTerminadoId" id="ProductoTerminadoId-error"></span>
                @if (productos.Count == 0) { <span class="field-help">No hay productos activos. <a asp-controller="Producto" asp-action="Create">Crear un producto</a>.</span> }
            </div>
            <noscript><p class="field-help">Selecciona solo el destino que corresponde al origen: materia prima para compra o producto para producción.</p></noscript>
        </section>
        <section class="form-section" aria-labelledby="entrada-cantidad">
            <div class="section-heading"><h2 id="entrada-cantidad">02 · Cantidad y costo</h2><span>Obligatorio, salvo donde se indique.</span></div>
            <div class="field-row">
                <div class="field"><label asp-for="Cantidad" class="field-label">Cantidad recibida</label><input asp-for="Cantidad" type="number" step="0.001" min="0.001" max="999999999999.999" inputmode="decimal" class="field-control" required aria-describedby="cantidad-help Cantidad-error" /><span class="field-help" id="cantidad-help" data-quantity-unit>Hasta 3 decimales.</span><span asp-validation-for="Cantidad" id="Cantidad-error"></span></div>
                <div class="field"><label asp-for="CostoUnitario" class="field-label">Costo unitario · MXN</label><input asp-for="CostoUnitario" type="number" step="0.01" min="0" max="999999999999.99" inputmode="decimal" class="field-control" required aria-describedby="costo-help CostoUnitario-error" /><span class="field-help" id="costo-help">Costo por unidad recibida. Puede ser cero.</span><span asp-validation-for="CostoUnitario" id="CostoUnitario-error"></span></div>
            </div>
            <div class="field"><label asp-for="Observaciones" class="field-label">Observaciones <span class="optional">Opcional</span></label><textarea asp-for="Observaciones" class="field-control" rows="3" maxlength="500" placeholder="Referencia de compra, lote o algún detalle de la recepción." aria-describedby="Observaciones-error"></textarea><span asp-validation-for="Observaciones" id="Observaciones-error"></span></div>
        </section>
        <div class="entry-preview"><span class="preview-label">Al registrar esta entrada</span><p data-entry-preview aria-live="polite" aria-atomic="true">Se sumará la cantidad recibida a las existencias del artículo seleccionado.</p></div>
        <div class="form-actions"><a class="button button-quiet" asp-action="Index">Cancelar</a><button class="button button-primary" type="submit">Registrar entrada</button></div>
    </form>
    <aside class="form-aside">
        <div class="aside-rule"></div><h2>Cada entrada tiene un destino</h2><p>Una compra suma existencias a una materia prima. Una producción terminada suma existencias a un producto.</p>
        <div class="aside-note"><h2>Revisa antes de guardar</h2><p>Confirma el artículo, su unidad y la cantidad recibida. La entrada quedará en el historial con su propio folio.</p><p>No se puede editar ni eliminar una entrada registrada desde esta pantalla.</p></div>
    </aside>
</div>
