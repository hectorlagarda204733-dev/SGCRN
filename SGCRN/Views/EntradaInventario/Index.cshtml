@model IReadOnlyList<EntradaInventario>
@{ ViewData["Title"] = "Entradas de inventario"; }
<header class="page-heading">
    <div><span class="eyebrow">Inventario</span><h1>Entradas</h1><p class="page-description">Compras de insumos y producción terminada.</p></div>
    <a class="button button-primary" asp-action="Create"><partial name="_Icon" model='@("plus")' />Registrar entrada</a>
</header>
<section class="data-surface" aria-label="Historial de entradas">
    @if (Model.Count == 0)
    {
        <div class="empty-state"><partial name="_Icon" model='@("entry")' /><h2>Registra tu primera entrada</h2><p>Cuando recibas insumos o termines una producción, registra la cantidad para actualizar tus existencias.</p><a class="button button-primary" asp-action="Create">Registrar entrada</a></div>
    }
    else
    {
        <div class="table-scroll" role="region" aria-label="Entradas, tabla desplazable" tabindex="0">
            <table class="records-table">
                <caption class="visually-hidden">Últimas 100 entradas de inventario, de más reciente a más antigua.</caption>
                <thead><tr><th scope="col">Folio</th><th scope="col">Artículo recibido</th><th scope="col">Origen</th><th scope="col">Fecha</th><th scope="col" class="numeric">Cantidad</th><th scope="col" class="numeric">Costo unitario</th></tr></thead>
                <tbody>
                @foreach (var entrada in Model)
                {
                    <tr>
                        <td data-label="Folio"><a class="record-name" asp-action="Details" asp-route-id="@entrada.Id">#@entrada.Id.ToString("D4")</a></td>
                        <td class="article-cell" data-label="Artículo recibido"><a class="record-name" asp-action="Details" asp-route-id="@entrada.Id">@(entrada.MateriaPrima?.Nombre ?? entrada.ProductoTerminado?.Nombre)</a></td>
                        <td data-label="Origen"><span class="type-label">@(entrada.TipoOrigen == TipoOrigenEntrada.Compra ? "Compra" : "Producción")</span></td>
                        <td data-label="Fecha">@entrada.Fecha.ToString("dd MMM yyyy")<div class="record-subtitle">@entrada.Fecha.ToString("HH:mm")</div></td>
                        <td class="numeric" data-label="Cantidad"><span class="quantity">+@entrada.Cantidad.ToString("N3")</span><div class="unit">@(entrada.MateriaPrima?.UnidadMedida ?? entrada.ProductoTerminado?.UnidadMedida)</div></td>
                        <td class="numeric" data-label="Costo unitario">@entrada.CostoUnitario.ToString("C2") <span class="unit">MXN</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    <div class="table-footer"><span>@Model.Count @(Model.Count == 1 ? "entrada mostrada" : "entradas mostradas") · Últimas 100</span><span class="footer-hint">De más reciente a más antigua</span></div>
</section>
