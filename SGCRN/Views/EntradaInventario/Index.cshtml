@model IReadOnlyList<EntradaInventario>
@{
    ViewData["Title"] = "Entradas de inventario";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1>Entradas de inventario · CU05</h1>
        <p class="text-muted mb-0">Compras de insumos y productos obtenidos al finalizar la producción.</p>
    </div>
    <a class="btn btn-success" asp-action="Create">+ Registrar entrada</a>
</div>
<section class="panel" aria-label="Historial de entradas">
    <h2 class="h5 mb-3">Últimas 100 entradas</h2>
    @if (Model.Count == 0)
    {
        <div class="alert alert-info mb-0" role="status">Aún no se registran entradas de inventario.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Fecha</th><th>Origen</th><th>Destino</th><th class="text-end">Cantidad</th><th class="text-end">Acciones</th></tr></thead>
                <tbody>
                @foreach (var entrada in Model)
                {
                    <tr>
                        <td>@entrada.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(entrada.TipoOrigen == TipoOrigenEntrada.Compra ? "Compra" : "Producción")</td>
                        <td>@(entrada.MateriaPrima?.Nombre ?? entrada.ProductoTerminado?.Nombre ?? "Sin destino")</td>
                        <td class="text-end">@entrada.Cantidad.ToString("N3")</td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@entrada.Id">Consultar</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
