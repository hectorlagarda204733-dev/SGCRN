<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · SGCRN</title>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="container d-flex flex-wrap align-items-center justify-content-between gap-2" aria-label="Navegación principal">
            <a class="brand" asp-controller="Producto" asp-action="Index">SGCRN <span>Remedios naturales</span></a>
            <div class="d-flex flex-wrap gap-2 gap-lg-3">
                <a class="nav-link" asp-controller="MateriaPrima" asp-action="Index">Materias primas · CU01</a>
                <a class="nav-link" asp-controller="Producto" asp-action="Index">Productos · CU02</a>
                <a class="nav-link" asp-controller="EntradaInventario" asp-action="Index">Inventario · CU05</a>
            </div>
        </nav>
    </header>
    <main class="container py-4 py-lg-5">
        <div class="eyebrow mb-2">GESTIÓN DE REMEDIOS NATURALES · CU01 · CU02 · CU05</div>
        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="alert alert-success" role="status">@mensaje</div>
        }
        @RenderBody()
    </main>
    <footer class="container py-4 text-muted small border-top">
        Sistema de Gestión y Catálogo de Remedios Naturales · Catálogos y entradas de inventario
    </footer>
</body>
</html>
