@model MateriaPrimaInput
@{
    ViewData["Title"] = "Registrar materia prima";
}
<h1>Registrar materia prima · CU01</h1>
<p class="text-muted">Completa el catálogo de insumos, sin capturar existencias.</p>
<div class="panel form-panel">
    <form asp-action="Create" method="post" novalidate>
        <partial name="_Campos" model="Model" />
        <p class="small text-muted">Las existencias inician en cero y solo CU05 las aumenta mediante entradas de inventario.</p>
        <div class="d-flex justify-content-end gap-2">
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
            <button class="btn btn-success" type="submit">Guardar materia prima</button>
        </div>
    </form>
</div>
