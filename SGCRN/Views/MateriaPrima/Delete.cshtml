@model MateriaPrima
@{
    ViewData["Title"] = "Dar de baja materia prima";
}
<h1>Dar de baja materia prima</h1>
<p class="text-muted">No se borrarán el registro ni el historial de inventario.</p>
<div class="panel form-panel">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
    <p>¿Confirmas la baja de <strong>@Model.Nombre</strong>?</p>
    @if (Model.Activo)
    {
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex justify-content-end gap-2">
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
            <button class="btn btn-danger" type="submit">Confirmar baja</button>
        </form>
    }
    else
    {
        <p class="text-muted">La materia prima ya está inactiva.</p>
        <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
    }
</div>
