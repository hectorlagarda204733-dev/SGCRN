@model MateriaPrimaInput
<div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" maxlength="150" required />
    <span asp-validation-for="Nombre" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="Descripcion" class="form-label"></label>
    <textarea asp-for="Descripcion" class="form-control" rows="3" maxlength="500"></textarea>
    <span asp-validation-for="Descripcion" class="text-danger small"></span>
</div>
<div class="mb-4">
    <label asp-for="UnidadMedida" class="form-label"></label>
    <input asp-for="UnidadMedida" class="form-control" maxlength="30" placeholder="Ej. kg o pieza" required />
    <span asp-validation-for="UnidadMedida" class="text-danger small"></span>
</div>
