@model MateriaPrimaInput
@{ ViewData["Title"] = "Editar materia prima"; }
<nav class="breadcrumb-trail" aria-label="Ubicación"><a asp-action="Index" data-catalog-back="MateriaPrima">Materias primas</a><span aria-hidden="true">/</span><a asp-action="Details" asp-route-id="@ViewContext.RouteData.Values["id"]">@Model.Nombre</a><span aria-hidden="true">/</span><span>Editar</span></nav>
<header class="page-heading"><div><h1>Editar materia prima</h1><p class="page-description">@Model.Nombre</p></div></header>
<partial name="_FormFeedback" />
<div class="form-layout">
    <form class="form-sheet" asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post" novalidate data-save-form>
        <partial name="_Campos" model="Model" />
        <div class="form-actions"><a class="button button-quiet" asp-action="Details" asp-route-id="@ViewContext.RouteData.Values["id"]">Cancelar</a><button class="button button-primary" type="submit">Guardar cambios</button></div>
    </form>
    <aside class="form-aside"><div class="aside-rule"></div><h2>Información del catálogo</h2><p>Las existencias y las entradas anteriores se conservan al guardar estos cambios.</p><div class="aside-note"><p>Si ya hay movimientos, conserva la unidad de medida para que las cantidades sigan siendo comparables.</p></div></aside>
</div>
