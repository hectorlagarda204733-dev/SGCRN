@model MateriaPrimaInput
@{
    ViewData["Title"] = "Editar materia prima";
}
<h1>Editar materia prima · CU01</h1>
<p class="text-muted">La edición del catálogo no modifica las existencias.</p>
<div class="panel form-panel">
    <form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post" novalidate>
        <partial name="_Campos" model="Model" />
        <div class="d-flex justify-content-end gap-2">
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
            <button class="btn btn-success" type="submit">Guardar cambios</button>
        </div>
    </form>
</div>
