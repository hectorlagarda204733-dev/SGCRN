@model MateriaPrimaCatalogoViewModel
@{
    ViewData["Title"] = "Materias primas";
    var filtered = !string.IsNullOrWhiteSpace(Model.Buscar) || Model.Activo.HasValue;
}
<header class="page-heading">
    <div><span class="eyebrow">Catálogos</span><h1>Materias primas</h1><p class="page-description">Ingredientes, envases y materiales de producción.</p></div>
    <a class="button button-primary" asp-action="Create"><partial name="_Icon" model='@("plus")' />Nueva materia prima</a>
</header>
<section class="data-surface" aria-label="Catálogo de materias primas" data-catalog="MateriaPrima">
    <form asp-action="Index" method="get" class="catalog-toolbar" role="search" aria-label="Buscar materias primas">
        <div class="search-field"><label asp-for="Buscar" class="field-label">Buscar materia prima</label><div class="input-wrap"><partial name="_Icon" model='@("search")' /><input asp-for="Buscar" type="search" class="field-control" placeholder="Nombre del ingrediente o material" /></div></div>
        <div class="filter-field"><label asp-for="Activo" class="field-label">Estado</label><select asp-for="Activo" class="field-control"><option value="">Todos</option><option value="true">Activas</option><option value="false">Inactivas</option></select></div>
        <button class="button" type="submit">Buscar</button>
        @if (filtered) { <a class="button button-quiet" asp-action="Index">Limpiar filtros</a> }
    </form>
    @if (Model.MateriasPrimas.Count == 0)
    {
        <div class="empty-state"><partial name="_Icon" model='@(filtered ? "search" : "leaf")' />
            <h2>@(filtered ? "No se encontraron materias primas" : "Aún no hay materias primas")</h2>
            <p>@(filtered ? "Prueba con otro nombre o cambia los filtros de búsqueda." : "Registra los ingredientes y materiales que utilizas para elaborar tus productos.")</p>
            @if (filtered) { <a class="button" asp-action="Index">Limpiar filtros</a> }
            else { <a class="button button-primary" asp-action="Create">Crear primera materia prima</a> }
        </div>
    }
    else
    {
        <div class="table-scroll" role="region" aria-label="Materias primas, tabla desplazable" tabindex="0">
            <table class="records-table">
                <caption class="visually-hidden">Materias primas: unidad, existencias, estado y acciones.</caption>
                <thead><tr><th scope="col">Materia prima</th><th scope="col">Unidad</th><th scope="col" class="numeric">Existencias</th><th scope="col">Estado</th><th scope="col" class="numeric">Acciones</th></tr></thead>
                <tbody>
                @foreach (var materia in Model.MateriasPrimas)
                {
                    <tr>
                        <td><div class="record-cell"><span class="record-symbol"><partial name="_Icon" model='@("leaf")' /></span><div><a class="record-name" asp-action="Details" asp-route-id="@materia.Id">@materia.Nombre</a><div class="record-subtitle">@materia.Descripcion</div></div></div></td>
                        <td class="unit" data-label="Unidad">@materia.UnidadMedida</td><td class="numeric quantity" data-label="Existencias">@materia.StockActual.ToString("N3")</td>
                        <td data-label="Estado"><span class="status @(materia.Activo ? "" : "status-inactive")">@(materia.Activo ? "Activa" : "Inactiva")</span></td>
                        <td class="actions-cell"><div class="row-actions"><a asp-action="Edit" asp-route-id="@materia.Id" aria-label="Editar @materia.Nombre">Editar</a>@if (materia.Activo) { <a class="danger-link" asp-action="Delete" asp-route-id="@materia.Id" aria-label="Dar de baja @materia.Nombre">Dar de baja</a> }</div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    <div class="table-footer"><span data-result-count="@Model.MateriasPrimas.Count">@Model.MateriasPrimas.Count @(Model.MateriasPrimas.Count == 1 ? "materia prima" : "materias primas")@(filtered ? " en esta búsqueda" : " en el catálogo")</span><span class="footer-hint">Selecciona una materia prima para ver su detalle.</span></div>
</section>
