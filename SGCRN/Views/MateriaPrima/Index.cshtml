@model MateriaPrimaCatalogoViewModel
@{
    ViewData["Title"] = "Catálogo de materias primas";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1>Materias primas · CU01</h1>
        <p class="text-muted mb-0">Catálogo de insumos utilizados para elaborar remedios naturales.</p>
    </div>
    <a class="btn btn-success" asp-action="Create">+ Registrar materia prima</a>
</div>
<section class="panel mb-4" aria-label="Filtros del catálogo">
    <form asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-md-6">
            <label asp-for="Buscar" class="form-label">Buscar por nombre</label>
            <input asp-for="Buscar" class="form-control" placeholder="Ej. manzanilla" />
        </div>
        <div class="col-md-3">
            <label asp-for="Activo" class="form-label">Estado</label>
            <select asp-for="Activo" class="form-select">
                <option value="">Todos</option><option value="true">Activas</option><option value="false">Inactivas</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-success" type="submit">Consultar</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
        </div>
    </form>
</section>
<section class="panel" aria-label="Materias primas registradas">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0">Materias primas registradas</h2>
        <span class="badge text-bg-light">@Model.MateriasPrimas.Count resultado(s)</span>
    </div>
    @if (Model.MateriasPrimas.Count == 0)
    {
        <div class="alert alert-info mb-0" role="status">No se encontraron materias primas.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Materia prima</th><th>Unidad</th><th class="text-end">Existencias</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
                <tbody>
                @foreach (var materia in Model.MateriasPrimas)
                {
                    <tr>
                        <td><strong>@materia.Nombre</strong><div class="small text-muted product-description">@materia.Descripcion</div></td>
                        <td>@materia.UnidadMedida</td>
                        <td class="text-end">@materia.StockActual.ToString("N3")</td>
                        <td><span class="badge @(materia.Activo ? "text-bg-success" : "text-bg-secondary")">@(materia.Activo ? "Activa" : "Inactiva")</span></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@materia.Id">Consultar</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@materia.Id">Editar</a>
                            @if (materia.Activo)
                            {
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@materia.Id">Dar de baja</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
<p class="small text-muted mt-3">Las existencias son de solo lectura aquí; se incrementan al registrar una entrada de inventario (CU05).</p>
