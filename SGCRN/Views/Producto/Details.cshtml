@model ProductoTerminado
@{ ViewData["Title"] = Model.Nombre; }
<nav class="breadcrumb-trail" aria-label="Ubicación"><a asp-action="Index" data-catalog-back="Producto">Productos</a><span aria-hidden="true">/</span><span>Detalle</span></nav>
<header class="page-heading">
    <div><span class="eyebrow">Producto #@Model.Id.ToString("D4")</span><h1>@Model.Nombre</h1></div>
    <div class="heading-actions"><span class="status @(Model.Activo ? "" : "status-inactive")">@(Model.Activo ? "Activo" : "Inactivo")</span><a class="button" asp-action="Edit" asp-route-id="@Model.Id"><partial name="_Icon" model='@("edit")' />Editar producto</a></div>
</header>
<div class="detail-layout">
    <article class="detail-panel">
        <h2>Información del producto</h2>
        <p class="detail-description">@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "Sin descripción." : Model.Descripcion)</p>
        <dl class="detail-grid">
            <div><dt>Unidad de medida</dt><dd>@Model.UnidadMedida</dd></div>
            <div><dt>Precio sugerido</dt><dd>@Model.PrecioSugerido.ToString("C2") <span class="unit">MXN</span></dd></div>
            <div><dt>Fecha de registro</dt><dd>@Model.CreadoEn.ToString("dd MMM yyyy, HH:mm")</dd></div>
            <div><dt>Última actualización</dt><dd>@Model.ActualizadoEn.ToString("dd MMM yyyy, HH:mm")</dd></div>
        </dl>
        @if (Model.Activo)
        {
            <div class="detail-meta"><a asp-action="Delete" asp-route-id="@Model.Id">Dar de baja este producto</a></div>
        }
    </article>
    <aside>
        @if (Uri.TryCreate(Model.ImagenUrl, UriKind.Absolute, out var imageUri) && (imageUri.Scheme == "https" || imageUri.Scheme == "http"))
        {
            <img class="product-image" src="@Model.ImagenUrl" alt="@Model.Nombre" referrerpolicy="no-referrer" data-product-image />
        }
        <section class="detail-panel stock-panel" aria-label="Inventario del producto">
            <dl><dt>Existencias actuales</dt><dd class="stock-value">@Model.StockActual.ToString("N3")</dd></dl><span class="unit">@Model.UnidadMedida</span>
            @if (Model.Activo)
            {
                <p>Registra una entrada cuando termines una producción.</p><a class="button" asp-controller="EntradaInventario" asp-action="Create"><partial name="_Icon" model='@("entry")' />Registrar entrada</a>
            }
            else { <p>Este producto está inactivo y no admite nuevas entradas.</p> }
        </section>
    </aside>
</div>
