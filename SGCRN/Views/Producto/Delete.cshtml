@model ProductoTerminado
@{ ViewData["Title"] = "Dar de baja producto"; }
<nav class="breadcrumb-trail" aria-label="Ubicación"><a asp-action="Index" data-catalog-back="Producto">Productos</a><span aria-hidden="true">/</span><a asp-action="Details" asp-route-id="@Model.Id">@Model.Nombre</a><span aria-hidden="true">/</span><span>Dar de baja</span></nav>
<partial name="_FormFeedback" />
<form class="form-sheet confirmation" asp-action="Delete" asp-route-id="@Model.Id" method="post" data-save-form>
    <div class="form-section">
        <span class="confirmation-symbol"><partial name="_Icon" model='@("warning")' /></span>
        <h1>@(Model.Activo ? "¿Dar de baja este producto?" : "Este producto ya está inactivo")</h1>
        <div class="record-reference">@Model.Nombre</div>
        <p>Su información y su historial se conservarán. Mientras esté inactivo, no podrás registrar nuevas entradas para este producto.</p>
        <p>Las existencias actuales no se modificarán.</p>
    </div>
    <div class="form-actions"><a class="button" asp-action="Details" asp-route-id="@Model.Id">@(Model.Activo ? "Cancelar" : "Volver al producto")</a>@if (Model.Activo) { <button class="button button-danger" type="submit">Dar de baja</button> }</div>
</form>
