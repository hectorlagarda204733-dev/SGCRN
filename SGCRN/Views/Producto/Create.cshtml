@model ProductoTerminadoInput
@{ ViewData["Title"] = "Nuevo producto"; }
<nav class="breadcrumb-trail" aria-label="Ubicación"><a asp-action="Index" data-catalog-back="Producto">Productos</a><span aria-hidden="true">/</span><span>Nuevo producto</span></nav>
<header class="page-heading"><div><h1>Nuevo producto</h1><p class="page-description">Define la presentación y el precio del producto.</p></div></header>
<partial name="_FormFeedback" />
<div class="form-layout">
    <form class="form-sheet" asp-action="Create" method="post" novalidate data-save-form>
        <partial name="_Campos" model="Model" />
        <div class="form-actions"><a class="button button-quiet" asp-action="Index" data-catalog-back="Producto">Cancelar</a><button class="button button-primary" type="submit">Crear producto</button></div>
    </form>
    <aside class="form-aside"><div class="aside-rule"></div><h2>Existencias iniciales</h2><p>Se creará activo y con existencias en cero. Cuando termines una producción, registra una entrada para agregar la cantidad obtenida.</p><div class="aside-note"><p>El nombre debe ser único, incluso entre productos inactivos.</p></div></aside>
</div>
